{
  "name": "trackr",
  "productName": "Trackr",
  "author": "KIZAFOX",
  "version": "0.2.9",
  "description": "Trackr, compagnon gratuit pour League of Legends : champ select, tableau de bord, overlay en partie.",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "previews": "electron tools/make-theme-previews.js",
    "dist": "node tools/release-notes.js && node -r dotenv/config tools/write-build-env.js && node -r dotenv/config ./node_modules/electron-builder/cli.js --publish never",
    "dist:mac": "node tools/release-notes.js && node -r dotenv/config tools/write-build-env.js && node -r dotenv/config ./node_modules/electron-builder/cli.js --mac --publish never",
    "dist:linux": "node tools/release-notes.js && node -r dotenv/config tools/write-build-env.js && node -r dotenv/config ./node_modules/electron-builder/cli.js --linux --publish never",
    "release": "node -r dotenv/config tools/check-release-env.js && node tools/release-notes.js && node -r dotenv/config tools/write-build-env.js && node -r dotenv/config ./node_modules/electron-builder/cli.js --publish always"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "dotenv": "^18.0.8",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0"
  },
  "build": {
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    },
    "appId": "fr.kiza.trackr",
    "productName": "Trackr",
    "copyright": "Copyright © KIZAFOX",
    "npmRebuild": false,
    "compression": "maximum",
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "files": [
      "package.json",
      "CHANGELOG.md",
      "assets/**/*",
      "src/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "sign": "tools/sign-win.js",
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Trackr",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "language": "1036",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "artifactName": "Trackr-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.games",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Trackr utilise le micro seulement si tu l'ajoutes au son de tes clips.",
        "NSAudioCaptureUsageDescription": "Trackr enregistre le son du Mac dans tes clips."
      }
    },
    "dmg": {
      "artifactName": "Trackr-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Game",
      "maintainer": "KIZAFOX",
      "synopsis": "Compagnon gratuit pour League of Legends",
      "artifactName": "Trackr-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KIZAFOX",
        "repo": "trackr",
        "releaseType": "draft"
      }
    ]
  }
}
